# docker compose configuration — copy to .env and fill in.
POSTGRES_PASSWORD=change-me-strong-password
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDICAL_KEY=
# Comma-separated origins allowed to call the API from browsers (dashboard + web app)
CORS_ORIGINS=http://localhost:4100
# Public base URL (used for medical-ID QR share links)
PUBLIC_URL=http://localhost:4100
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
API_PORT=4100
